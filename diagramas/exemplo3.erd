    "memoEntities": {
      "8Jgo4SNvkHloQxMydYoNB": {
        "id": "8Jgo4SNvkHloQxMydYoNB",
        "value": "Controle de manutenção de equipamentos de laboratório.\n\nÉ preciso registrar salas, equipamentos e sua lotação nos espaços físicos.\nFaz-se necessário também poder fazer um controle de manutenção desses equipamentos.\nÉ importante poder saber quem fez a manutenção e a lotação do equipamento para fins de auditoria.\nPor fim é necessário que um equipamento possa ser desativado, ficando lotado em um setor específico para isso.",
        "ui": {
          "x": 587.5032,
          "y": -4.6893,
          "zIndex": 2,
          "width": 608,
          "height": 101,
          "color": ""
        },
        "meta": {
          "updateAt": 1786998611286,
          "createAt": 1786470651658
        }
      }
    }
